// Esquema de datos de PawCare.
//
// CONVENCIÓN DE NOMBRES (ver docs/GLOSARIO_EN_ES.md):
//   - Todo identificador de código está en INGLÉS (modelos, campos, enums y sus valores).
//   - Todo texto visible para el usuario está en ESPAÑOL, y vive en la capa de UI
//     (frontend) o en los mensajes de error de los servicios — nunca en nombres de campo.
//   - Toda tabla física lleva el prefijo `st_` y va en snake_case plural, vía @@map.
//     Los nombres de columna quedan en camelCase (igual que el campo del modelo).
//
// database/MODELO_DATOS.md documenta el porqué de cada decisión de modelado.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  VET
  RECEPTIONIST
}

enum RecordStatus {
  ACTIVE
  INACTIVE
}

enum AppointmentStatus {
  CONFIRMED
  ATTENDED
  CANCELLED
}

enum VisitPaymentStatus {
  PENDING
  PAID
}

enum PreventiveControlType {
  VACCINE
  DEWORMING
}

enum InventoryMoveType {
  IN
  OUT
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  QR
}

enum QrChargeStatus {
  PENDING
  CONFIRMED
  EXPIRED
  ERROR
}

enum NotificationChannel {
  EMAIL
  WHATSAPP_MANUAL
  WHATSAPP_API
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

model User {
  id               Int          @id @default(autoincrement())
  firstName        String       @db.VarChar(80)
  paternalLastName String       @db.VarChar(80)
  maternalLastName String?      @db.VarChar(80)
  nationalId       String       @unique @db.VarChar(20)
  username         String       @unique @db.VarChar(50)
  passwordHash     String
  email            String?      @unique @db.VarChar(120)
  phone            String?      @db.VarChar(20)
  address          String?
  role             Role
  status           RecordStatus @default(ACTIVE)
  selfRegistered   Boolean      @default(false)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  vet                 Vet?
  petChanges          PetChange[]
  passwordResetTokens PasswordResetToken[]
  sentInvitations     VetInvitation[]
  auditLogs           AuditLog[]
  loginEvents         LoginEvent[]

  @@index([role])
  @@map("st_users")
}

model Vet {
  id            Int          @id @default(autoincrement())
  userId        Int          @unique
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  licenseNumber String       @unique @db.VarChar(20)
  specialty     String       @db.VarChar(80)
  status        RecordStatus @default(ACTIVE)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  schedules    Schedule[]
  appointments Appointment[]
  visits       MedicalVisit[]

  @@index([status])
  @@map("st_vets")
}

model Schedule {
  id        Int      @id @default(autoincrement())
  vetId     Int
  vet       Vet      @relation(fields: [vetId], references: [id], onDelete: Cascade)
  dayOfWeek Int
  startTime DateTime @db.Time
  endTime   DateTime @db.Time

  @@unique([vetId, dayOfWeek, startTime])
  @@index([vetId])
  @@map("st_schedules")
}

model Owner {
  id               Int      @id @default(autoincrement())
  firstName        String   @db.VarChar(80)
  paternalLastName String   @db.VarChar(80)
  maternalLastName String?  @db.VarChar(80)
  nationalId       String   @unique @db.VarChar(20)
  phone            String?  @db.VarChar(20)
  address          String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  pets          Pet[]
  notifications Notification[]

  @@index([paternalLastName, firstName])
  @@map("st_owners")
}

model Pet {
  id        Int          @id @default(autoincrement())
  ownerId   Int
  owner     Owner        @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  name      String       @db.VarChar(60)
  species   String       @db.VarChar(40)
  breed     String?      @db.VarChar(60)
  color     String?      @db.VarChar(40)
  sex       String?      @db.VarChar(10)
  birthDate DateTime?    @db.Date
  weight    Decimal?     @db.Decimal(5, 2)
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  appointments       Appointment[]
  visits             MedicalVisit[]
  preventiveControls PreventiveControl[]
  changes            PetChange[]

  @@unique([ownerId, name, species])
  @@index([ownerId])
  @@index([status])
  @@map("st_pets")
}

model Appointment {
  id               Int               @id @default(autoincrement())
  code             String            @unique @db.VarChar(20)
  dateTime         DateTime
  durationMin      Int               @default(30)
  petId            Int
  pet              Pet               @relation(fields: [petId], references: [id], onDelete: Restrict)
  vetId            Int
  vet              Vet               @relation(fields: [vetId], references: [id], onDelete: Restrict)
  consultationType String            @db.VarChar(60)
  reason           String?
  status           AppointmentStatus @default(CONFIRMED)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  notifications Notification[]

  @@index([vetId, dateTime])
  @@index([petId, dateTime])
  @@index([status, dateTime])
  @@map("st_appointments")
}

model MedicalVisit {
  id              Int                @id @default(autoincrement())
  petId           Int
  pet             Pet                @relation(fields: [petId], references: [id], onDelete: Restrict)
  vetId           Int
  vet             Vet                @relation(fields: [vetId], references: [id], onDelete: Restrict)
  date            DateTime           @default(now())
  diagnosis       String
  treatment       String
  externalExams   String?
  serviceType     String
  weight          Decimal?           @db.Decimal(5, 2)
  consultationFee Decimal            @db.Decimal(10, 2)
  paymentStatus   VisitPaymentStatus @default(PENDING)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  payment        Payment?
  inventoryMoves InventoryMove[]
  qrCharges      QrCharge[]

  @@index([petId, date])
  @@index([paymentStatus])
  @@index([serviceType, date])
  @@map("st_medical_visits")
}

model Payment {
  id      Int           @id @default(autoincrement())
  visitId Int           @unique
  visit   MedicalVisit  @relation(fields: [visitId], references: [id], onDelete: Restrict)
  method  PaymentMethod
  amount  Decimal       @db.Decimal(10, 2)
  date    DateTime      @default(now())

  createdAt DateTime @default(now())

  @@index([date])
  @@index([method])
  @@map("st_payments")
}

// Intento de cobro por QR bancario (riel "QR Simple" interoperable, vía la API propia
// del banco comercial elegido — no una API única nacional). Una MedicalVisit puede
// tener varios intentos (uno expira o falla, se genera otro) pero solo uno debería
// llegar a CONFIRMED; al confirmarse por webhook se crea el Payment real (mismo efecto
// que registrar un pago manual con method QR), no lo reemplaza.
model QrCharge {
  id                Int            @id @default(autoincrement())
  visitId           Int
  visit             MedicalVisit   @relation(fields: [visitId], references: [id], onDelete: Restrict)
  amount            Decimal        @db.Decimal(10, 2)
  status            QrChargeStatus @default(PENDING)
  provider          String         @db.VarChar(40)
  externalReference String?        @unique @db.VarChar(100)
  qrPayload         String?
  expiresAt         DateTime?
  confirmedAt       DateTime?
  createdAt         DateTime       @default(now())

  @@index([visitId])
  @@index([status])
  @@map("st_qr_charges")
}

model PreventiveControl {
  id          Int                   @id @default(autoincrement())
  petId       Int
  pet         Pet                   @relation(fields: [petId], references: [id], onDelete: Cascade)
  type        PreventiveControlType
  // Qué se aplicó y de qué frasco. Es lo que un tercero busca en el carnet: el
  // SENASAG pide marca y lote de la antirrábica para el certificado de viaje, y otra
  // clínica necesita saber qué se puso para decidir el refuerzo. Opcionales porque
  // los controles ya cargados no los tienen, y porque en una campaña de vacunación
  // masiva no siempre se anota el lote.
  productName String?               @db.VarChar(80)
  batchNumber String?               @db.VarChar(40)
  appliedOn   DateTime              @db.Date
  nextDoseOn  DateTime?             @db.Date
  createdAt   DateTime              @default(now())

  notifications Notification[]

  @@index([petId])
  @@index([nextDoseOn])
  @@map("st_preventive_controls")
}

model Medication {
  id           Int      @id @default(autoincrement())
  name         String   @unique @db.VarChar(100)
  currentStock Int      @default(0)
  minimumStock Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  moves InventoryMove[]

  @@map("st_medications")
}

model InventoryMove {
  id           Int               @id @default(autoincrement())
  medicationId Int
  medication   Medication        @relation(fields: [medicationId], references: [id], onDelete: Restrict)
  type         InventoryMoveType
  quantity     Int
  date         DateTime          @default(now())
  visitId      Int?
  visit        MedicalVisit?     @relation(fields: [visitId], references: [id], onDelete: SetNull)

  @@index([medicationId, date])
  @@index([visitId])
  @@map("st_inventory_moves")
}

model Notification {
  id                  Int                 @id @default(autoincrement())
  ownerId             Int
  owner               Owner               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  appointmentId       Int?
  appointment         Appointment?        @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  preventiveControlId Int?
  preventiveControl   PreventiveControl?  @relation(fields: [preventiveControlId], references: [id], onDelete: SetNull)
  channel             NotificationChannel
  message             String
  status              NotificationStatus  @default(PENDING)
  sentAt              DateTime?
  createdAt           DateTime            @default(now())

  @@index([status])
  @@index([channel, status])
  @@map("st_notifications")
}

// Bitácora de ediciones manuales a los datos de un Pet (pantalla de ficha
// individual). Un cambio de peso registrado en una MedicalVisit NO genera fila
// acá — ya queda visible como parte de esa atención en el historial; esta tabla
// es solo para ediciones directas del registro (ej. corregir raza o sexo).
model PetChange {
  id       Int      @id @default(autoincrement())
  petId    Int
  pet      Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)
  field    String
  oldValue String?
  newValue String?
  date     DateTime @default(now())
  userId   Int?
  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([petId, date])
  @@map("st_pet_changes")
}

// Token de un solo uso para "olvidé mi contraseña" (POST /api/auth/forgot-password).
// Vive fuera de User porque puede haber varias solicitudes sin usar/expiradas
// a la vez y se necesita el historial (usedAt) para no reusar un token ya gastado.
model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("st_password_reset_tokens")
}

// Invitación de un Administrador a un Veterinario nuevo por email — alternativa al
// preregistro público (POST /api/users/preregister): la cuenta creada al aceptar
// queda ACTIVE de una (el Admin ya decidió invitar a esa persona), no pendiente de
// aprobación. Convive con el preregistro abierto, no lo reemplaza.
model VetInvitation {
  id          Int       @id @default(autoincrement())
  email       String    @db.VarChar(120)
  name        String?   @db.VarChar(80)
  token       String    @unique
  invitedById Int
  invitedBy   User      @relation(fields: [invitedById], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([invitedById])
  @@index([email])
  @@map("st_vet_invitations")
}

enum AuditAction {
  ACTIVATE_ACCOUNT
  DEACTIVATE_ACCOUNT
  RESET_PASSWORD
  CHANGE_ROLE
  INVITE_VET
}

// Bitácora de acciones administrativas sensibles sobre OTRAS cuentas — quién hizo
// qué, sobre quién, cuándo. No registra acciones sobre el propio actor (ej. cambiar
// tu propia contraseña no genera fila acá, eso no necesita auditoría).
model AuditLog {
  id         Int         @id @default(autoincrement())
  actorId    Int?
  actor      User?       @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     AuditAction
  entityType String      @db.VarChar(40)
  entityId   Int?
  details    String?
  date       DateTime    @default(now())

  @@index([date])
  @@index([actorId])
  @@map("st_audit_logs")
}

enum LoginOutcome {
  SUCCESS
  INVALID_CREDENTIALS
  INACTIVE_ACCOUNT
}

/// Registro de intentos de inicio de sesión: quién entró, cuándo, desde qué IP y con
/// qué navegador — y también los intentos fallidos, que son justamente los que
/// interesan cuando alguien pregunta "¿quién estuvo intentando entrar?".
///
/// Va aparte de `AuditLog` a propósito: aquel registra acciones administrativas
/// sobre OTRAS cuentas y siempre tiene un actor conocido, mientras que un intento
/// fallido puede no corresponder a ningún usuario existente. Además tiene campos
/// propios (IP, user agent, resultado) y un volumen mucho mayor: mezclarlos taparía
/// las pocas acciones administrativas que la auditoría existe para mostrar.
model LoginEvent {
  id        Int          @id @default(autoincrement())
  /// Nulo cuando el usuario tecleado no existe: igual se guarda el intento.
  userId    Int?
  user      User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// El nombre de usuario tal como se tecleó, exista o no.
  username  String       @db.VarChar(50)
  outcome   LoginOutcome
  ipAddress String?      @db.VarChar(60)
  userAgent String?      @db.VarChar(400)
  date      DateTime     @default(now())

  @@index([date])
  @@index([userId])
  @@index([outcome, date])
  @@map("st_login_events")
}
