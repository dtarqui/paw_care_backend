// Copiado tal cual desde database/MODELO_DATOS.md (sección 6).
// database/MODELO_DATOS.md es la fuente de referencia — si este archivo diverge, ese es el que manda.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Rol {
  ADMINISTRADOR
  VETERINARIO
  RECEPCIONISTA
}

enum EstadoRegistro {
  ACTIVO
  INACTIVO
}

enum EstadoCita {
  CONFIRMADA
  ATENDIDA
  CANCELADA
}

enum EstadoPagoAtencion {
  PENDIENTE
  PAGADO
}

enum TipoControlPreventivo {
  VACUNA
  DESPARASITACION
}

enum TipoMovimientoInventario {
  ENTRADA
  SALIDA
}

enum MetodoPago {
  EFECTIVO
  TARJETA
  TRANSFERENCIA
  QR
}

enum EstadoCobroQr {
  PENDIENTE
  CONFIRMADO
  EXPIRADO
  ERROR
}

enum CanalNotificacion {
  EMAIL
  WHATSAPP_MANUAL
  WHATSAPP_API
}

enum EstadoNotificacion {
  PENDIENTE
  ENVIADO
  FALLIDO
}

model Usuario {
  id              Int             @id @default(autoincrement())
  nombre          String          @db.VarChar(80)
  apellidoPaterno String          @db.VarChar(80)
  apellidoMaterno String?         @db.VarChar(80)
  ci              String          @unique @db.VarChar(20)
  username        String          @unique @db.VarChar(50)
  passwordHash    String
  email           String?         @unique @db.VarChar(120)
  telefono        String?         @db.VarChar(20)
  direccion       String?
  rol             Rol
  estado          EstadoRegistro  @default(ACTIVO)
  autorregistrado Boolean         @default(false)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  veterinario         Veterinario?
  cambiosMascota      CambioMascota[]
  tokensRecuperacion  PasswordResetToken[]
  invitacionesEnviadas InvitacionVeterinario[]
  accionesAuditoria   RegistroAuditoria[]

  @@index([rol])
}

model Veterinario {
  id            Int             @id @default(autoincrement())
  usuarioId     Int             @unique
  usuario       Usuario         @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  matricula     String          @unique @db.VarChar(20)
  especialidad  String          @db.VarChar(80)
  estado        EstadoRegistro  @default(ACTIVO)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  horarios      Horario[]
  citas         Cita[]
  atenciones    AtencionMedica[]

  @@index([estado])
}

model Horario {
  id            Int         @id @default(autoincrement())
  veterinarioId Int
  veterinario   Veterinario @relation(fields: [veterinarioId], references: [id], onDelete: Cascade)
  diaSemana     Int
  horaInicio    DateTime    @db.Time
  horaFin       DateTime    @db.Time

  @@unique([veterinarioId, diaSemana, horaInicio])
  @@index([veterinarioId])
}

model Propietario {
  id              Int       @id @default(autoincrement())
  nombre          String    @db.VarChar(80)
  apellidoPaterno String    @db.VarChar(80)
  apellidoMaterno String?   @db.VarChar(80)
  ci              String    @unique @db.VarChar(20)
  telefono        String?   @db.VarChar(20)
  direccion       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  mascotas        Mascota[]
  notificaciones  Notificacion[]

  @@index([apellidoPaterno, nombre])
}

model Mascota {
  id              Int         @id @default(autoincrement())
  propietarioId   Int
  propietario     Propietario @relation(fields: [propietarioId], references: [id], onDelete: Restrict)
  nombre          String      @db.VarChar(60)
  especie         String      @db.VarChar(40)
  raza            String?     @db.VarChar(60)
  color           String?     @db.VarChar(40)
  sexo            String?     @db.VarChar(10)
  fechaNacimiento DateTime?   @db.Date
  peso            Decimal?    @db.Decimal(5, 2)
  estado          EstadoRegistro @default(ACTIVO)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  citas           Cita[]
  atenciones      AtencionMedica[]
  controles       ControlPreventivo[]
  cambios         CambioMascota[]

  @@unique([propietarioId, nombre, especie])
  @@index([propietarioId])
  @@index([estado])
}

model Cita {
  id            Int         @id @default(autoincrement())
  codigo        String      @unique @db.VarChar(20)
  fechaHora     DateTime
  duracionMin   Int         @default(30)
  mascotaId     Int
  mascota       Mascota     @relation(fields: [mascotaId], references: [id], onDelete: Restrict)
  veterinarioId Int
  veterinario   Veterinario @relation(fields: [veterinarioId], references: [id], onDelete: Restrict)
  tipoConsulta  String      @db.VarChar(60)
  motivo        String?
  estado        EstadoCita  @default(CONFIRMADA)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  notificaciones Notificacion[]

  @@index([veterinarioId, fechaHora])
  @@index([mascotaId, fechaHora])
  @@index([estado, fechaHora])
}

model AtencionMedica {
  id               Int                @id @default(autoincrement())
  mascotaId        Int
  mascota          Mascota            @relation(fields: [mascotaId], references: [id], onDelete: Restrict)
  veterinarioId    Int
  veterinario      Veterinario        @relation(fields: [veterinarioId], references: [id], onDelete: Restrict)
  fecha            DateTime           @default(now())
  diagnostico      String
  tratamiento      String
  examenesExternos String?
  tipoServicio     String
  peso             Decimal?           @db.Decimal(5, 2)
  montoConsulta    Decimal            @db.Decimal(10, 2)
  estadoPago       EstadoPagoAtencion @default(PENDIENTE)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  pago             Pago?
  movimientos      MovimientoInventario[]
  cobrosQr         CobroQr[]

  @@index([mascotaId, fecha])
  @@index([estadoPago])
  @@index([tipoServicio, fecha])
}

model Pago {
  id         Int            @id @default(autoincrement())
  atencionId Int            @unique
  atencion   AtencionMedica @relation(fields: [atencionId], references: [id], onDelete: Restrict)
  metodoPago MetodoPago
  monto      Decimal        @db.Decimal(10, 2)
  fecha      DateTime       @default(now())
  createdAt  DateTime       @default(now())

  @@index([fecha])
  @@index([metodoPago])
}

// Intento de cobro por QR bancario (riel "QR Simple" interoperable, vía la API propia
// del banco comercial elegido — no una API única nacional). Una AtencionMedica puede
// tener varios intentos (uno expira o falla, se genera otro) pero solo uno debería
// llegar a CONFIRMADO; al confirmarse por webhook se crea el Pago real (mismo efecto
// que registrar un pago manual con metodoPago QR), no lo reemplaza.
model CobroQr {
  id                Int           @id @default(autoincrement())
  atencionId        Int
  atencion          AtencionMedica @relation(fields: [atencionId], references: [id], onDelete: Restrict)
  monto             Decimal       @db.Decimal(10, 2)
  estado            EstadoCobroQr @default(PENDIENTE)
  proveedor         String        @db.VarChar(40)
  referenciaExterna String?       @unique @db.VarChar(100)
  qrPayload         String?
  expiraEn          DateTime?
  confirmadoEn      DateTime?
  createdAt         DateTime      @default(now())

  @@index([atencionId])
  @@index([estado])
}

model ControlPreventivo {
  id              Int                   @id @default(autoincrement())
  mascotaId       Int
  mascota         Mascota               @relation(fields: [mascotaId], references: [id], onDelete: Cascade)
  tipo            TipoControlPreventivo
  fechaAplicacion DateTime              @db.Date
  proximaDosis    DateTime?             @db.Date
  createdAt       DateTime              @default(now())

  notificaciones  Notificacion[]

  @@index([mascotaId])
  @@index([proximaDosis])
}

model Medicamento {
  id          Int      @id @default(autoincrement())
  nombre      String   @unique @db.VarChar(100)
  stockActual Int      @default(0)
  stockMinimo Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  movimientos MovimientoInventario[]
}

model MovimientoInventario {
  id            Int                      @id @default(autoincrement())
  medicamentoId Int
  medicamento   Medicamento              @relation(fields: [medicamentoId], references: [id], onDelete: Restrict)
  tipo          TipoMovimientoInventario
  cantidad      Int
  fecha         DateTime                 @default(now())
  atencionId    Int?
  atencion      AtencionMedica?          @relation(fields: [atencionId], references: [id], onDelete: SetNull)

  @@index([medicamentoId, fecha])
  @@index([atencionId])
}

model Notificacion {
  id                  Int                @id @default(autoincrement())
  propietarioId       Int
  propietario         Propietario        @relation(fields: [propietarioId], references: [id], onDelete: Cascade)
  citaId              Int?
  cita                Cita?              @relation(fields: [citaId], references: [id], onDelete: SetNull)
  controlPreventivoId Int?
  controlPreventivo   ControlPreventivo? @relation(fields: [controlPreventivoId], references: [id], onDelete: SetNull)
  canal               CanalNotificacion
  mensaje             String
  estado              EstadoNotificacion @default(PENDIENTE)
  enviadoEn           DateTime?
  createdAt           DateTime           @default(now())

  @@index([estado])
  @@index([canal, estado])
}

// Bitácora de ediciones manuales a los datos de una Mascota (pantalla de ficha
// individual). Un cambio de peso registrado en una AtencionMedica NO genera fila
// acá — ya queda visible como parte de esa atención en el historial; esta tabla
// es solo para ediciones directas del registro (ej. corregir raza o sexo).
model CambioMascota {
  id            Int      @id @default(autoincrement())
  mascotaId     Int
  mascota       Mascota  @relation(fields: [mascotaId], references: [id], onDelete: Cascade)
  campo         String
  valorAnterior String?
  valorNuevo    String?
  fecha         DateTime @default(now())
  usuarioId     Int?
  usuario       Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([mascotaId, fecha])
}

// Token de un solo uso para "olvidé mi contraseña" (POST /api/auth/forgot-password).
// Vive fuera de Usuario porque puede haber varias solicitudes sin usar/expiradas
// a la vez y se necesita el historial (usadoEn) para no reusar un token ya gastado.
model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  usuarioId Int
  usuario   Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  token     String    @unique
  expiraEn  DateTime
  usadoEn   DateTime?
  createdAt DateTime  @default(now())

  @@index([usuarioId])
}

// Invitación de un Administrador a un Veterinario nuevo por email — alternativa al
// preregistro público (POST /api/usuarios/preregistro): la cuenta creada al aceptar
// queda ACTIVO de una (el Admin ya decidió invitar a esa persona), no pendiente de
// aprobación. Convive con el preregistro abierto, no lo reemplaza.
model InvitacionVeterinario {
  id            Int       @id @default(autoincrement())
  email         String    @db.VarChar(120)
  nombre        String?   @db.VarChar(80)
  token         String    @unique
  invitadoPorId Int
  invitadoPor   Usuario   @relation(fields: [invitadoPorId], references: [id], onDelete: Cascade)
  expiraEn      DateTime
  aceptadaEn    DateTime?
  createdAt     DateTime  @default(now())

  @@index([invitadoPorId])
  @@index([email])
}

enum AccionAuditoria {
  ACTIVAR_CUENTA
  DESACTIVAR_CUENTA
  RESTABLECER_PASSWORD
  CAMBIAR_ROL
  INVITAR_VETERINARIO
}

// Bitácora de acciones administrativas sensibles sobre OTRAS cuentas — quién hizo
// qué, sobre quién, cuándo. No registra acciones sobre el propio actor (ej. cambiar
// tu propia contraseña no genera fila acá, eso no necesita auditoría).
model RegistroAuditoria {
  id          Int              @id @default(autoincrement())
  actorId     Int?
  actor       Usuario?         @relation(fields: [actorId], references: [id], onDelete: SetNull)
  accion      AccionAuditoria
  entidadTipo String           @db.VarChar(40)
  entidadId   Int?
  detalle     String?
  fecha       DateTime         @default(now())

  @@index([fecha])
  @@index([actorId])
}
