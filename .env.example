PORT=4000
JWT_SECRET=demo-secret-cambiar-en-produccion
# Latencia artificial (ms) para simular una consulta real a base de datos en el modo demo
DEMO_DELAY_MS=0
# URL(s) del frontend desplegado, separadas por coma. Sin definir, CORS queda abierto.
# También se usa (la primera) para armar los links de los emails de recuperación/invitación.
FRONTEND_URL=

# SMTP para "olvidé mi contraseña" e invitación de veterinario por email.
# Sin estas 3 variables, esos endpoints responden un error claro (EmailNoConfiguradoError)
# en vez de fingir que el correo se envió — ver lib/mailer.ts.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Opcional — si no se define, se usa SMTP_USER como remitente.
SMTP_FROM=

# Cobro por QR bancario (sesión 6) — riel "QR Simple" vía el banco comercial elegido
# (BCP, Banco Unión, BNB, etc.). Ninguna de estas variables conecta nada todavía:
# lib/pagoQr.ts#generarCobroQrBancario() lanza ProveedorPagoQrNoConfiguradoError
# siempre, hasta reemplazar su cuerpo por la llamada HTTP real del banco elegido
# (no hay documentación técnica pública que permita escribirla sin adivinar).
# PAGO_QR_WEBHOOK_SECRET sí es funcional: el banco debe mandarlo en el header
# X-Webhook-Secret al notificar un pago (POST /api/pagos/qr/webhook).
PAGO_QR_BANCO=
PAGO_QR_API_URL=
PAGO_QR_API_KEY=
PAGO_QR_WEBHOOK_SECRET=

# Supabase (Project Settings -> Database -> Connection string)
# Pooled connection (pgbouncer, puerto 6543) - la usa la app en tiempo de ejecución.
DATABASE_URL="postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-xx-xxxx-x.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection (puerto 5432) - la usa Prisma para migraciones.
DIRECT_URL="postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-xx-xxxx-x.pooler.supabase.com:5432/postgres"
