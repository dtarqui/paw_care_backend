PORT=4000
JWT_SECRET=demo-secret-cambiar-en-produccion
# Latencia artificial (ms) para simular una consulta real a base de datos en el modo demo
DEMO_DELAY_MS=0

# Supabase (Project Settings -> Database -> Connection string)
# Pooled connection (pgbouncer, puerto 6543) - la usa la app en tiempo de ejecución.
DATABASE_URL="postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-xx-xxxx-x.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection (puerto 5432) - la usa Prisma para migraciones.
DIRECT_URL="postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-xx-xxxx-x.pooler.supabase.com:5432/postgres"
